# Copy to .env locally. Never paste keys into chats or commit .env.
# Empty values mean unavailable; model definitions omit these providers.
AMAP_API_KEY=
QWEATHER_API_KEY=
# Account-specific host from QWeather console, e.g. your-project.qweatherapi.com.
QWEATHER_API_HOST=
BOCHA_API_KEY=

# Optional railway and coach suppliers. Separate product permissions are required.
# Railway prefers the official public page; fallback is disclosed in each result.
TRAIN_SEARCH_PROVIDER=12306
TRAIN_FALLBACK_PROVIDER=flyai
COACH_SEARCH_PROVIDER=bus365
# Independent runtime: uv run playwright install chromium (no desktop session required).
BROWSER_QUERIES_ENABLED=false
BROWSER_QUERY_TIMEOUT_SECONDS=18
BROWSER_QUERY_CACHE_SECONDS=0
JUHE_TRAIN_API_KEY=
# Reference coach schedules/fares only; this provider does not query by travel date.
# Select COACH_SEARCH_PROVIDER=jisu explicitly to use this older adapter.
JISU_COACH_API_KEY=

# Official FlyAI CLI searches: install pinned package with scripts/setup_flyai.ps1.
# Set a formal key OR explicitly opt into limited experience mode. Neither is automatic.
FLYAI_API_KEY=
FLYAI_ENABLE_DEMO=false
# Full Node executable path, for example C:/Program Files/nodejs/node.exe on Windows.
FLYAI_NODE_PATH=
FLYAI_CLI_PATH=.tools/flyai-cli/package/dist/flyai-bundle.cjs
FLYAI_STATE_DIRECTORY=private/flyai

# Conservative tool execution limits, not Agent stopping-policy decisions.
TOOL_TIMEOUT_SECONDS=20
MAX_CONCURRENT_CALLS=4

# Agent model. Never paste keys into chats or commit .env.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_THINKING=true
LLM_REASONING_EFFORT=high
LLM_TIMEOUT_SECONDS=120

# Alternative vendor: set LLM_PROVIDER=openai_compatible and all three fields.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Local MVP default. PostgreSQL supported via postgresql+asyncpg://... when configured.
DATABASE_URL=sqlite+aiosqlite:///private/travel-agent.db
AGENT_ENGINE=langgraph
AGENT_MAX_STEPS=12
AGENT_MAX_RUN_SECONDS=300
