# Copy to .env locally. Never paste keys into chats or commit .env.
# Empty values mean unavailable; model definitions omit these providers.
AMAP_API_KEY=
QWEATHER_API_KEY=
# Account-specific host from QWeather console, e.g. your-project.qweatherapi.com.
QWEATHER_API_HOST=
BOCHA_API_KEY=

# Conservative tool execution limits, not Agent stopping-policy decisions.
TOOL_TIMEOUT_SECONDS=20
MAX_CONCURRENT_CALLS=4

# Flights/trains/coaches/hotels have no registered supplier in this base catalog yet.
# No model key is needed or used by this project stage.
